# Copy to .env.local (never commit secrets)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

ALLOWED_EMAIL_DOMAIN=ucsi.edu.bd
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=ucsi.edu.bd

# Netlify Functions base path (default: /netlify/functions — rewritten to /.netlify/functions)
# NEXT_PUBLIC_NETLIFY_FUNCTIONS_BASE=/netlify/functions

# Session close ping delay after a successful scan (minutes); spec Pivot 6 uses T+20
NEXT_PUBLIC_SESSION_CLOSE_MINUTES=20
SESSION_CLOSE_TIMEOUT_MINUTES=30

OVERRIDE_PIN_DEFAULT_EXPIRY_MINUTES=10
OVERRIDE_PIN_MAX_EXPIRY_MINUTES=30
